# ======================================================================
# SM-HomePage — variables de entorno
# Copia este archivo a ".env" y ajusta los valores según tu infraestructura.
# Todas las variables documentadas en español para el ingeniero de infra.
# ======================================================================

# --- Servidor ----------------------------------------------------------
# Puerto HTTP donde escucha la app (por defecto 3000).
PORT=3000

# Entorno de ejecución: development | production.
# En development se permite la cookie sin Secure (http://localhost) y
# MAIL_DRIVER=log responde "dev_code" en la API (solo si ENABLE_DEV_CODE != false).
# IMPORTANTE: en producción MAIL_DRIVER=log está PROHIBIDO (fail-fast al arrancar).
NODE_ENV=development

# Clave secreta usada para firmar/rotar tokens CSRF y otros fines.
# Usa un valor largo y aleatorio:  openssl rand -hex 32
SESSION_SECRET=change-me-con-un-valor-largo-y-aleatorio

# Días de vida de una sesión (por defecto 30).
SESSION_DAYS=30

# Rotación deslizante de sesión (F5): tras N días de antigüedad se emite un
# token nuevo y se revoca el anterior. Por defecto 7.
SESSION_ROTATE_DAYS=7

# Si es true, cada login revoca TODAS las sesiones previas del usuario
# (trade-off: rompe multi-dispositivo; por defecto false).
REVOKE_ALL_ON_LOGIN=false

# --- Base de datos -----------------------------------------------------
# Cadena de conexión PostgreSQL (formato URI).
# Ejemplo local (docker): postgres://corphomepage:corphomepage@localhost:5432/corphomepage
# Ejemplo en compose: postgres://corphomepage:corphomepage@db:5432/corphomepage
DATABASE_URL=postgres://corphomepage:corphomepage@localhost:5432/corphomepage

# --- Autenticación / OTP ----------------------------------------------
# Dominios de correo permitidos para iniciar sesión, separados por coma.
# Ejemplo: "miempresa.com"  o  "miempresa.com,otraempresa.com"
# En development, si está vacío, se permite el dominio "localhost".
# NOTA: en runtime estos dominios se gestionan desde la BD (tabla settings,
# clave allowed_domains) con PRECEDENCIA sobre esta variable. En el primer
# arranque se siembran desde aquí.
ALLOWED_DOMAINS=localhost
# Alias recomendado (nuevo). Si ALLOWED_EMAIL_DOMAINS existe, tiene prioridad
# sobre ALLOWED_DOMAINS. Úsalo para que quede claro que es la allow-list de
# correo: ALLOWED_EMAIL_DOMAINS=tu-dominio.com

# Email que SIEMPRE obtiene el rol super_admin al hacer login (bootstrap).
# Es la ÚNICA vía de bootstrap (ya no existe "primer usuario -> super_admin").
# OBLIGATORIO en producción (fail-fast si falta). Debe pertenecer a un dominio permitido.
# Usuario inicial: en una BD vacía, al primer arranque se crea automáticamente
# este usuario con rol super_admin (idempotente; en BD poblada NO se auto-crea).
SUPER_ADMIN_EMAIL=admin@tu-dominio.com

# Token de bootstrap del super_admin (opcional). Dos opciones de despliegue:
#
#  OPCIÓN 1 (recomendada): definir BOOTSTRAP_TOKEN=<secreto>. El primer login
#  de SUPER_ADMIN_EMAIL exige presentar este token (single-use: se consume al
#  usarse). En la pantalla de login, si el email prefijado (?email=...) coincide
#  con SUPER_ADMIN_EMAIL, aparece UN INPUT VISIBLE "Token de arranque" para
#  escribirlo. En dev, si ENABLE_DEV_CODE != false, la API además lo incluye en
#  la respuesta de /auth/request.
#  Generar con:  openssl rand -hex 32
#
#  OPCIÓN 2: NO definir BOOTSTRAP_TOKEN en producción. Entonces el primer
#  login de SUPER_ADMIN_EMAIL completa el bootstrap directamente, sin token
#  (bootstrap solo con SUPER_ADMIN_EMAIL).
BOOTSTRAP_TOKEN=

# OPCIÓN 3: Código corto de primer inicio (6 dígitos, de un solo uso).
# Se genera automáticamente con deploy.sh (Asistente v2). Prioridad sobre BOOTSTRAP_TOKEN.
# Solo se exige en la primera activación del super_admin. Ejemplo: 483912
BOOTSTRAP_CODE=

# Exponer el campo "dev_code" en la API. Por defecto true SOLO en development;
# nunca se activa en producción aunque se ponga true aquí.
ENABLE_DEV_CODE=true

# TTL del código OTP en minutos (por defecto 10).
OTP_TTL_MIN=10

# --- Correo ------------------------------------------------------------
# Driver de envío de correo: log | smtp | sendgrid.
#   log      -> imprime el código OTP en la consola (SÓLO para pruebas locales).
#   smtp     -> envía correo real mediante Nodemailer (configura SMTP_* abajo).
#   sendgrid -> envía mediante SendGrid vía SMTP (SENDGRID_API_KEY abajo).
MAIL_DRIVER=log

# Remitente por defecto de los correos OTP. En runtime, settings.mail_from
# (tabla settings) tiene precedencia sobre esta variable.
MAIL_FROM=no-reply@tu-dominio.com

# Configuración SMTP (obligatoria si MAIL_DRIVER=smtp).
# Ejemplo para una cuenta de correo corporativa o un relay interno.
SMTP_HOST=smtp.miempresa.com
SMTP_PORT=587
SMTP_USER=no-reply@miempresa.com
SMTP_PASS=la-contrasena-del-relay
SMTP_FROM="SM-HomePage <no-reply@miempresa.com>"

# SendGrid vía SMTP (obligatoria si MAIL_DRIVER=sendgrid). La clave SOLO vive
# en env (NUNCA en la BD ni en settings). El dominio remitente debe estar
# verificado en SendGrid. La app NO arranca (fail-fast) si MAIL_DRIVER=sendgrid
# y esta variable falta. Generarla en https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=

# Cookie Secure configurable (P3). Por defecto Secure=true en producción.
# Descomenta y pon COOKIE_SECURE=false SOLO si el borde de la red interna / VPN
# NO termina TLS y el portal se sirve por HTTP plano interno. RECOMENDADO:
# terminar TLS en el borde y dejar Secure=true (no definir esta variable).
# COOKIE_SECURE=false

# --- Modo anónimo y reverse proxy (seguridad del despliegue) -------------
# Modo anónimo del dashboard: por defecto ACTIVO (GET / muestra las apps
# públicas sin sesión, comportamiento actual). ANONYMOUS_MODE=off lo desactiva:
# GET / sin sesión redirige a /login. RECOMENDADO: ANONYMOUS_MODE=off en
# despliegues solo-autenticados expuestos a Internet (TLS).
# ANONYMOUS_MODE=off

# Hops de reverse proxy de confianza para el rate limiting y la auditoría
# (expres-rate-limit usa req.ip). Solo configúralo si hay un proxy delante:
#   TRUST_PROXY=1  -> detrás de Caddy/Nginx con TLS (X-Forwarded-For fiable).
#   TRUST_PROXY=0  -> (default) red interna directa / red privada (VPN): req.ip es la IP
#                     real y un X-Forwarded-For forjado NO altera el limitado.
# NUNCA actives TRUST_PROXY sin un reverse proxy de confianza delante.
TRUST_PROXY=0

# --- Personalización del portal (opcional) -----------------------------
# URL de imagen de fondo opcional (se usa como fondo del body).
# Si se deja vacío, se usa el color de fondo por defecto (CSS var --bg).
PORTAL_BG_IMAGE=

# Color de fondo por defecto (hex). Ej: #0f1115
PORTAL_BG_COLOR=#0f1115

# Nombre del sitio. En runtime settings.site_name tiene precedencia.
SITE_NAME=SM-HomePage

# Tema por defecto del portal: light | dark | system. En runtime,
# settings.default_theme tiene precedencia (editable en /admin/settings).
DEFAULT_THEME=system

# --- Docker compose (no suele ser necesario editarlas) -----------------
POSTGRES_DB=corphomepage
POSTGRES_USER=corphomepage
# OBLIGATORIO: genera una contraseña aleatoria de 32 caracteres hex (ej: openssl rand -hex 32)
POSTGRES_PASSWORD=change-me-aleatorio-32-hex
